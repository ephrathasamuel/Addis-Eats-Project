# Supabase project settings (customer accounts and Google sign-in). Use the
# project URL and publishable key from Supabase Dashboard > Project Settings > API.
# The anon key is also supported. Leave empty to use local customer accounts.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Signs local session cookies. Use a long random value in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If empty, a random secret is generated and stored in the data directory.
ADDIS_SESSION_SECRET=""

# First admin account, created on first start when no admin exists. If empty,
# admin@addiseats.com / ChangeMe-Admin1 is created and must be changed.
ADDIS_ADMIN_EMAIL=""
ADDIS_ADMIN_PASSWORD=""

# Optional directory for the local JSON stores (orders, dishes, accounts, uploads).
ADDIS_DATA_DIR=""

# Public canonical URL for metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Payment integration credentials belong in a secret manager when enabled.
TELEBIRR_API_KEY=""
CHAPA_SECRET_KEY=""

# Server-only Supabase key (starts with sb_secret_). Lets every server share
# one database and explains failed sign-ins. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""

# Push notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Restaurant location used for driving-time estimates (defaults to Bole Road).
ADDIS_RESTAURANT_LAT=""
ADDIS_RESTAURANT_LNG=""

# Optional: Google Maps Platform key with the Routes API enabled. Turns the
# road estimate into a live-traffic estimate. Billed by Google per request.
GOOGLE_MAPS_API_KEY=""
