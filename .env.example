# Supabase project settings. Use the project URL and publishable key from
# Supabase Dashboard > Project Settings > API. The anon key is also supported.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Optional directory for the existing local JSON order store.
ADDIS_DATA_DIR=""

# Public canonical URL for metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Payment integration credentials belong in a secret manager when enabled.
TELEBIRR_API_KEY=""
CHAPA_SECRET_KEY=""
