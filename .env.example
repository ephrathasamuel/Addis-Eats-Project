# Supabase project settings (customer accounts and Google sign-in). Use the
# project URL and publishable key from Supabase Dashboard > Project Settings > API.
# The anon key is also supported. Leave empty to use local customer accounts.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Signs local session cookies. Use a long random value in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If empty, a random secret is generated and stored in the data directory.
ADDIS_SESSION_SECRET=""

# First admin account, created on first start when no admin exists. If empty,
# admin@addiseats.com / ChangeMe-Admin1 is created and must be changed.
ADDIS_ADMIN_EMAIL=""
ADDIS_ADMIN_PASSWORD=""

# Optional directory for the local JSON stores (orders, dishes, accounts, uploads).
ADDIS_DATA_DIR=""

# Public canonical URL for metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Payment integration credentials belong in a secret manager when enabled.
TELEBIRR_API_KEY=""
CHAPA_SECRET_KEY=""
