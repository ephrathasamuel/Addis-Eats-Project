# Server-only environment settings. Replace example values in .env.local;
# never commit real credentials.

# Durable database connection for a multi-instance deployment.
DATABASE_URL=""

# Optional local store directory; defaults to .addis-data in the project root.
# JSON persistence is suitable for local single-process development only.
ADDIS_DATA_DIR=""

# Provisioned staff accounts. Use distinct email addresses and passwords of
# at least 12 characters. Customer registration cannot create privileged roles.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"
STAFF_EMAIL=""
STAFF_PASSWORD=""
STAFF_NAME="Kitchen Staff"
DELIVERY_EMAIL=""
DELIVERY_PASSWORD=""
DELIVERY_NAME="Delivery Courier"

# Public canonical URL for metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Payment integration credentials belong in a secret manager when enabled.
TELEBIRR_API_KEY=""
CHAPA_SECRET_KEY=""
