# ==============================================================================
# Addis Eats Environment Configuration Matrix (.env.example)
# ==============================================================================
# Reference guide for local development, Vercel preview, and production environments.
# Copy this file to .env.local for local development. Never commit real secrets to git!

# ------------------------------------------------------------------------------
# 1. Server-Only Secrets (Private to Next.js server runtime / Server Actions)
# ------------------------------------------------------------------------------
# Development: Local postgres instance or SQLite
# Preview:     Isolated seeded preview database branch (e.g. Neon branching)
# Production:  High-availability managed production database
DATABASE_URL="postgres://postgres:postgres@localhost:5432/addiseats"

# Session Cookie Signing Secret (Must be >= 32 characters, unique per environment)
# Development: local-dev-secret-32-chars-long
# Preview:     vercel-preview-session-secret-unique
# Production:  [Cryptographically random production key from `openssl rand -hex 32`]
SESSION_SECRET="addis-eats-super-secret-session-key-at-least-32-chars-long"

# Payment Gateways (e.g. TeleBirr, Chapa)
# Development: test_telebirr_mock_sandbox_key
# Preview:     test_telebirr_mock_sandbox_key
# Production:  live_telebirr_merchant_production_key
TELEBIRR_API_KEY="test_telebirr_mock_sandbox_key"
CHAPA_SECRET_KEY="CHASECK_TEST-sample-test-chapa-key"

# ------------------------------------------------------------------------------
# 2. Public Client Variables (Inlined at build time via NEXT_PUBLIC_ prefix)
# ------------------------------------------------------------------------------
# Canonical Base URL for Metadata, Sitemap, OpenGraph & Absolute Redirects
# Development: http://localhost:3000
# Preview:     https://$VERCEL_URL (set automatically by Vercel)
# Production:  https://addiseats.et
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Application Environment Identifier ("development" | "preview" | "production")
NEXT_PUBLIC_APP_ENV="development"

# API Version Tag
NEXT_PUBLIC_API_VERSION="v1"
